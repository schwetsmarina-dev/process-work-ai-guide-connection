{
  "name": "Term",
  "type": "object",
  "properties": {
    "term_id": {
      "type": "string",
      "description": "Unique term identifier"
    },
    "latin_key": {
      "type": "string",
      "description": "Short latin identifier matching ModeStep.related_term_ids (e.g. body_signal, primary_process)"
    },
    "term": {
      "type": "string",
      "description": "Term name in Russian/source language"
    },
    "term_es": {
      "type": "string",
      "description": "Spanish term name"
    },
    "category": {
      "type": "string",
      "description": "Term category"
    },
    "category_es": {
      "type": "string",
      "description": "Spanish localization of category when user-visible"
    },
    "is_cross_cutting": {
      "type": "boolean",
      "default": false
    },
    "primary_mode_id": {
      "type": "string",
      "description": "Primary mode this term belongs to"
    },
    "mode_ids": {
      "type": "string",
      "description": "All applicable mode IDs (comma-separated or JSON)"
    },
    "short_definition": {
      "type": "string",
      "description": "Short definition in Russian/source language"
    },
    "short_definition_es": {
      "type": "string",
      "description": "Spanish short definition"
    },
    "practical_application": {
      "type": "string",
      "description": "Practical application in Russian/source language"
    },
    "practical_application_es": {
      "type": "string",
      "description": "Spanish practical application"
    },
    "related_terms": {
      "type": "string",
      "description": "Related term IDs or names"
    },
    "search_tags": {
      "type": "string",
      "description": "Search tags in Russian/source language"
    },
    "search_tags_es": {
      "type": "string",
      "description": "Spanish search tags"
    },
    "source": {
      "type": "string",
      "description": "Source reference"
    },
    "source_sheet": {
      "type": "string",
      "description": "Source spreadsheet or document"
    },
    "aliases": {
      "type": "string",
      "description": "Aliases in Russian/source language"
    },
    "aliases_es": {
      "type": "string",
      "description": "Spanish aliases and natural search synonyms"
    },
    "notes": {
      "type": "string",
      "description": "Additional internal notes"
    },
    "notes_es": {
      "type": "string",
      "description": "Spanish localization of notes only if ever user-visible"
    }
  },
  "required": [
    "term"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}