{
  "name": "EdgeProgramDay",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "program_id": {
      "type": "string"
    },
    "day_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28
    },
    "week_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "title": {
      "type": "string"
    },
    "practice_text": {
      "type": "string"
    },
    "journal_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reflection": {
      "type": "string"
    },
    "distress_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "distress_after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "felt_dissociated": {
      "type": "boolean",
      "default": false
    },
    "felt_overwhelmed": {
      "type": "boolean",
      "default": false
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "safety_action": {
      "type": "string",
      "enum": [
        "none",
        "repeat_previous",
        "soft_version",
        "resource_day",
        "pause",
        "stop_and_seek_support"
      ],
      "default": "none"
    },
    "theme": {
      "type": "string"
    },
    "experience_type": {
      "type": "string"
    },
    "signal": {
      "type": "string"
    },
    "stopping_signal": {
      "type": "string"
    },
    "stopping_message": {
      "type": "string"
    },
    "familiar_way": {
      "type": "string"
    },
    "emerging_signal": {
      "type": "string"
    },
    "emerging_quality": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "support_figure": {
      "type": "string"
    },
    "preferred_support": {
      "type": "string"
    },
    "user_correction": {
      "type": "string"
    },
    "next_day_adjustment": {
      "type": "string"
    },
    "selected_story_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_id",
    "program_id",
    "day_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}