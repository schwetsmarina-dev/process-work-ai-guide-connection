{
  "name": "UserMemory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Authenticated owner user id"
    },
    "memory_level": {
      "type": "string",
      "enum": [
        "episodic",
        "semantic",
        "dynamic"
      ],
      "default": "episodic",
      "description": "episodic = source session observation; semantic = cross-session process hypothesis; dynamic = change over time"
    },
    "memory_type": {
      "type": "string",
      "description": "Type of memory: theme, pattern, body_signal, edge, edge_figure, primary_process, secondary_process, resource, progress, change. edge_figure is stored as a separate row, never merged into edge."
    },
    "memory_key": {
      "type": "string",
      "description": "Stable topic/key used for retrieval and grouping"
    },
    "memory_value": {
      "type": "string",
      "description": "Human-readable memory content"
    },
    "related_memory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Explicit links to related memory records owned by the same user; e.g. an edge_figure record points to its edge record."
    },
    "source_mode_id": {
      "type": "string",
      "description": "Mode where an episodic memory was created"
    },
    "source_session_id": {
      "type": "string",
      "description": "Primary source session for episodic memory"
    },
    "evidence_session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sessions supporting this semantic/dynamic hypothesis"
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 0,
      "default": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence 0-1; hypotheses remain provisional"
    },
    "importance": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "trend": {
      "type": "string",
      "enum": [
        "new",
        "stable",
        "strengthening",
        "weakening",
        "changed",
        "resolved"
      ],
      "description": "Longitudinal direction for dynamic memories"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "confirmed",
        "corrected",
        "rejected"
      ],
      "default": "unreviewed",
      "description": "User review state; rejected items must not be used by AI"
    },
    "user_note": {
      "type": "string",
      "maxLength": 2000
    },
    "original_value": {
      "type": "string",
      "description": "Original AI wording retained when user corrects a memory"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "excluded_from_ai": {
      "type": "boolean",
      "default": false,
      "description": "If true, keep visible to the user but never inject into AI context"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description"
    }
  },
  "required": [
    "user_id",
    "memory_key",
    "memory_value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}