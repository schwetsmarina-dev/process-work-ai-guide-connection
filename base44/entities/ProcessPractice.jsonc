{
  "name": "ProcessPractice",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to AppUser (owner of this practice)"
    },
    "language": {
      "type": "string",
      "description": "ru/es/en \u2014 language of the generated practice"
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "True when generated via the admin test trigger, bypassing the readiness threshold"
    },
    "confidence_score": {
      "type": "number",
      "description": "0-100 process-recurrence confidence at time of generation"
    },
    "theme_label": {
      "type": "string",
      "description": "Short label for the recurring theme this practice addresses"
    },
    "dominant_channel": {
      "type": "string",
      "enum": [
        "body",
        "dream",
        "conflict",
        "journaling",
        "mixed"
      ],
      "description": "Perceptual channel the exploration question is built around"
    },
    "source_session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sessions that informed this practice"
    },
    "offer_text": {
      "type": "string",
      "description": "The reflective offer message shown to the user before generating/accepting the practice"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "The 7-step Personal Process Practice script, structured"
    },
    "full_text": {
      "type": "string",
      "description": "Full practice script concatenated, used for display and as TTS input"
    },
    "low_data_warning": {
      "type": "boolean",
      "default": false,
      "description": "True when generated from insufficient material (test mode with little/no session history)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "failed"
      ],
      "default": "ready"
    },
    "audio_status": {
      "type": "string",
      "enum": [
        "none",
        "generating",
        "ready",
        "failed"
      ],
      "default": "none"
    },
    "audio_url": {
      "type": "string",
      "description": "Public URL of the generated audio (cloned voice)"
    },
    "audio_error": {
      "type": "string",
      "description": "Error detail when audio generation failed, e.g. missing secret"
    },
    "voice_id": {
      "type": "string",
      "description": "ElevenLabs voice_id used for this audio"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description"
    }
  },
  "required": [
    "user_id",
    "full_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}